# NebulaDay for Ghostty, part of cosmic-nebuladay-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = NebulaDay
# or, with the Nebula half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Nebula,light:NebulaDay

