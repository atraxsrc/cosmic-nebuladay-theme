# NebulaDay for delta (the git diff pager), part of cosmic-nebuladay-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat NebulaDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/nebuladay.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = nebuladay

[delta "nebuladay"]
    light = true
    syntax-theme = NebulaDay
    navigate = true
    line-numbers = true

    file-style = bold "#186A61"
    file-decoration-style = "#CED1D4" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#CED1D4" box
    hunk-header-file-style = "#31469B"
    hunk-header-line-number-style = "#604686"

    minus-style = "#A8243B" "#F1F3F6"
    minus-emph-style = bold "#E2E5E9" "#A8243B"
    minus-non-emph-style = "#A8243B" "#F1F3F6"
    plus-style = "#1D6778" "#F1F3F6"
    plus-emph-style = bold "#E2E5E9" "#1D6778"
    plus-non-emph-style = "#1D6778" "#F1F3F6"
    zero-style = syntax
    whitespace-error-style = "#E2E5E9" "#914C27"

    line-numbers-left-style = "#CED1D4"
    line-numbers-right-style = "#CED1D4"
    line-numbers-minus-style = "#A8243B"
    line-numbers-plus-style = "#1D6778"
    line-numbers-zero-style = "#858EA2"

    commit-style = bold "#604686"
    commit-decoration-style = "#CED1D4" box
    blame-palette = "#E2E5E9 #F1F3F6 #D8DBDF"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#1D6778"
    merge-conflict-theirs-diff-header-style = bold "#914C27"
